# Copy to .env and fill in what you need. .env is git-ignored.
# You do NOT need every key -- pick one model provider to start.

# --- Model providers (at least one) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Which provider the library uses when a call doesn't name one.
AGENTIC_DEFAULT_PROVIDER=anthropic

# --- Tools used by the labs -----------------------------------------------
# Web search for the research labs. Free tier is plenty: https://tavily.com
TAVILY_API_KEY=

# --- Cost control ---------------------------------------------------------
# Hard ceiling in USD for a single agent run. The run raises BudgetExceeded
# rather than quietly spending more. Set to 0 to disable the guard.
AGENTIC_RUN_BUDGET_USD=1.00

# Where JSONL traces are written.
AGENTIC_TRACE_DIR=.runs
